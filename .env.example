# Copy to .env and fill in real values. .env is git-ignored and must never be committed.
#
#   cp .env.example .env
#
# Generate the secrets rather than typing them:
#   openssl rand -hex 32

# ---------------------------------------------------------------- catalog MongoDB
CATALOG_MONGO_USERNAME=catalog
CATALOG_MONGO_PASSWORD=replace-me-mongo-password

# ------------------------------------------------------------- auth PostgreSQL
AUTH_POSTGRES_DB=authdb
AUTH_POSTGRES_USER=auth
AUTH_POSTGRES_PASSWORD=replace-me-auth-db-password

# ------------------------------------------------------------ order PostgreSQL
ORDER_POSTGRES_DB=orderdb
ORDER_POSTGRES_USER=orders
ORDER_POSTGRES_PASSWORD=replace-me-order-db-password

# ------------------------------------------------------------------------- Redis
REDIS_PASSWORD=replace-me-redis-password

# --------------------------------------------------------------------------- JWT
# Shared between auth-service (which signs) and api-gateway (which verifies).
# Must be at least 32 bytes for HS256. Both services refuse to start without it.
JWT_SECRET=replace-me-with-at-least-32-bytes-of-random-secret

# ------------------------------------------------------------------------- CORS
# Comma separated list of browser origins allowed to call the gateway.
# No wildcard: an unset or wrong value fails closed.
GATEWAY_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://ecommerce-backend-51pg.onrender.com/api/$1"
    },
    {
      "source": "/((?!assets/|images/).*)",
      "destination": "/index.html"
    }
  ],
  "env": {
    "VITE_API_BASE_URL": "https://ecommerce-backend-51pg.onrender.com/api",
    "VITE_IMAGE_BASE_URL": "https://ecommerce-backend-51pg.onrender.com"
  }
}

# Copy to frontend/.env.local for local development. Both files are git-ignored.

# Everything the browser calls goes through the api-gateway, which owns the /api
# prefix and routes to catalog-service, auth-service and order-service. There is one
# base URL now rather than a different host per concern.
#
# Local (docker compose):   http://localhost:8080/api
# Production:               https://<your-gateway-host>/api
VITE_API_BASE_URL=http://localhost:8080/api

# Product images are served from this app's own public/images directory, so this
# stays on the app origin. Point it at the gateway only if you switch to serving
# images from catalog-service via /api/images.
VITE_IMAGE_BASE_URL=
